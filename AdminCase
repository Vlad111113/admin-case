<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AdminCase</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #1a1a2e;
            color: #fff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 40px;
            color: #ff6b6b;
            text-shadow: 0 0 20px rgba(255, 107, 107, 0.5);
        }

        .boxes {
            display: flex;
            gap: 30px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .box {
            width: 220px;
            height: 280px;
            background: #16213e;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 15px;
            border: 2px solid #0f3460;
            text-decoration: none;
            color: #fff;
        }

        .box:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .box.cheap {
            border-color: #4caf50;
        }

        .box.cheap:hover {
            box-shadow: 0 20px 40px rgba(76, 175, 80, 0.3);
        }

        .box.expensive {
            border-color: #ffd700;
        }

        .box.expensive:hover {
            box-shadow: 0 20px 40px rgba(255, 215, 0, 0.3);
        }

        .box-icon {
            font-size: 4rem;
        }

        .box-name {
            font-size: 1.4rem;
            font-weight: bold;
        }

        .box-price {
            font-size: 1rem;
            opacity: 0.7;
        }
    </style>
</head>
<body>

    <h1>AdminCase</h1>

    <div class="boxes">
        <!-- Дешевый бокс -->
        <a href="#" class="box cheap">
            <div class="box-icon">📦</div>
            <div class="box-name">Дешевый</div>
            <div class="box-price">Скоро описание</div>
        </a>

        <!-- Дорогой бокс -->
        <a href="#" class="box expensive">
            <div class="box-icon">🎁</div>
            <div class="box-name">Дорогой</div>
            <div class="box-price">Скоро описание</div>
        </a>
    </div>

</body>
</html>
